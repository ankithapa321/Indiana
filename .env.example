# Copy to .env.local and fill in. Never prefix secrets with NEXT_PUBLIC_.

# Printify — https://printify.com/app/account/api
PRINTIFY_API_KEY=
# The "INDIANA" store. Other stores on the same account are not used.
PRINTIFY_SHOP_ID=29432707

# Stripe — required for Buy Now / bag checkout (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe
# (event: checkout.session.completed). Creates the Printify order after payment.
STRIPE_WEBHOOK_SECRET=
# Comma-separated ISO country codes Stripe Checkout accepts shipping addresses for.
STRIPE_SHIPPING_COUNTRIES=US
# Set to "true" to send paid orders straight to production; otherwise they wait on hold in Printify.
PRINTIFY_SEND_TO_PRODUCTION=false
